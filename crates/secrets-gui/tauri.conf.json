{
  "productName": "Secrets",
  "version": "0.1.0",
  "identifier": "dev.david.secrets",
  "build": {
    "frontendDist": "../secrets-gui/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Secrets",
        "width": 1680,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 800,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
